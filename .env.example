# =============================================================================
# Oneclickhr — environment
#
# Copy to `.env.local` for development, and set the same values in the Vercel
# project for production.
#
# Nothing secret may ever carry the NEXT_PUBLIC_ prefix — that prefix inlines a
# value into the JavaScript bundle the browser downloads. The two public entries
# below are public by design (the anon key is meaningless without RLS, which is
# the whole point of the policies in 002_rls.sql).
#
# src/lib/env.ts validates all of this at boot: it THROWS in development on a
# missing critical variable, and logs loudly in production rather than taking
# the site down over a misconfigured optional integration.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely — every query made with it must re-filter
# by tenant_id in application code. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed if you mint Realtime tokens yourself; this build uses
# the user's native auth session for Realtime, so it can stay empty.
SUPABASE_JWT_SECRET=

# --- Application URL ---------------------------------------------------------
# Used for links in email and for the Google Calendar webhook address. No
# trailing slash. In production this is https://app.oneclickhr.app — the
# apex domain is reserved for the marketing site, hosted as a separate project.
APP_URL=http://localhost:3000

# --- Email: Resend -----------------------------------------------------------
# ALL transactional email — auth (confirm signup, password reset) AND product
# (employee credentials, visa reminders, announcements) — is sent from the app
# with the Resend API. See SETUP.md §4.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
EMAIL_FROM="Oneclickhr <no-reply@oneclickhr.app>"

# Secret for Supabase's "Send Email" Auth Hook, which POSTs to
# /api/auth/send-email-hook instead of Supabase sending the email itself.
# Dashboard -> Authentication -> Hooks -> Send Email -> copy the "Signing
# Secret" (starts with `v1,whsec_...`) as-is. See SETUP.md §4.
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# --- Cloudflare R2 (S3-compatible object storage) ----------------------------
# ONE PRIVATE BUCKET. Nothing in it is publicly readable — payslips, visa
# documents and even org logos are served through short-lived signed URLs after
# an authorization check. Do NOT enable public access on this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nextkinlife-ems
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com — set
# it only if you use a custom S3 endpoint.
R2_ENDPOINT=
# Optional, used ONLY by `npm run r2:doctor`. Comma-separated list of every
# origin the app is served from, so the doctor can prove the bucket's CORS
# policy accepts uploads from each one. Defaults to APP_URL + localhost:3000.
R2_CORS_ORIGINS=

# --- Google Calendar (two-way sync) ------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). The redirect URI must match EXACTLY, including scheme.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# AES-256-GCM key encrypting each org's Google refresh token at rest.
#
# THIS FAILS CLOSED. It must be 64 hexadecimal characters, or base64 that
# decodes to exactly 32 bytes. Any other value is REFUSED — connecting a
# calendar will fail with a clear message rather than silently deriving a weaker
# key from whatever you typed. Generate one with:
#     openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Cron ---------------------------------------------------------------------
# Sent as the `x-cron-secret` header and compared in CONSTANT TIME. At least 16
# characters; generate with:  openssl rand -hex 32
# Without it, /api/cron/* answers 503 and the visa reminder engine never runs.
# Set the same value as a header on both cron-job.org jobs (SETUP.md §10) — that
# is the only supported scheduler; there is no Vercel Cron or pg_cron schedule.
CRON_SECRET=

# --- Optional tuning ----------------------------------------------------------
# Per-purpose upload caps are set in src/lib/upload.ts; override the general one
# here if you need to.
# UPLOAD_MAX_BYTES_DEFAULT=52428800
